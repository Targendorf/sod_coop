<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <AssemblyName>SoDCoop</AssemblyName>
    <Product>Shadow of Doubt Coop Mod</Product>
    <Version>0.1.0</Version>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <DebugType>portable</DebugType>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <RestoreAdditionalProjectSources>
      https://api.nuget.org/v3/index.json;
      https://nuget.bepinex.dev/v3/index.json
    </RestoreAdditionalProjectSources>
    <!-- Gale mod manager profile path -->
    <BepInExPath>$(APPDATA)\com.kesomannen.gale\shadows-of-doubt\profiles\Default\BepInEx</BepInExPath>

    <!--
      Dump source-generator output to disk under obj/<Cfg>/generated/ so
      contributors can read the emitted Serialize/Deserialize bodies for
      [NetPacket] structs. Pure debugging convenience — generator output
      is compiled into the DLL whether this is on or off.
    -->
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
    <CompilerGeneratedFilesOutputPath>$(BaseIntermediateOutputPath)$(Configuration)\generated</CompilerGeneratedFilesOutputPath>
  </PropertyGroup>

  <!-- Exclude the Assembly-CSharp dump folder — it is for reference only, not compilation -->
  <ItemGroup>
    <Compile Remove="Assembly-CSharp_Dump\**" />
    <None Include="Assembly-CSharp_Dump\**" />
  </ItemGroup>

  <!--
    Exclude the source-generator subproject from the main project's default
    *.cs glob. It compiles separately as netstandard2.0 (different
    Roslyn-required TFM) and is wired in below via Analyzer ProjectReference.
  -->
  <ItemGroup>
    <Compile Remove="SoDCoop.Generators\**" />
    <None Include="SoDCoop.Generators\**\*.cs" />
    <None Include="SoDCoop.Generators\**\*.csproj" />
  </ItemGroup>

  <!-- BepInEx IL2CPP Dependencies -->
  <ItemGroup>
    <PackageReference Include="BepInEx.Unity.IL2CPP" Version="6.0.0-be.*" IncludeAssets="compile" />
    <PackageReference Include="BepInEx.PluginInfoProps" Version="2.*" />
    <PackageReference Include="LiteNetLib" Version="1.2.0" />
    <PackageReference Include="ZstdSharp.Port" Version="0.8.*" />
  </ItemGroup>

  <!--
    Source generator project. Referenced as an Analyzer so its DLL runs at
    compile time emitting Serialize/Deserialize for [NetPacket] partial
    structs, but never ships in the runtime plugin DLL.
    ReferenceOutputAssembly=false keeps the generator's dependencies from
    bleeding into the build output.
  -->
  <ItemGroup>
    <ProjectReference Include="SoDCoop.Generators\SoDCoop.Generators.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

  <!-- IL2CPP Interop References from Gale mod manager -->
  <ItemGroup>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(BepInExPath)\interop\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(BepInExPath)\interop\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(BepInExPath)\interop\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Il2Cppmscorlib">
      <HintPath>$(BepInExPath)\interop\Il2Cppmscorlib.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Il2CppSystem">
      <HintPath>$(BepInExPath)\interop\Il2CppSystem.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.PhysicsModule">
      <HintPath>$(BepInExPath)\interop\UnityEngine.PhysicsModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.IMGUIModule">
      <HintPath>$(BepInExPath)\interop\UnityEngine.IMGUIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.InputLegacyModule">
      <HintPath>$(BepInExPath)\interop\UnityEngine.InputLegacyModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.AnimationModule">
      <HintPath>$(BepInExPath)\interop\UnityEngine.AnimationModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.AIModule">
      <HintPath>$(BepInExPath)\interop\UnityEngine.AIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.TextRenderingModule">
      <HintPath>$(BepInExPath)\interop\UnityEngine.TextRenderingModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- uGUI for the Canvas-based co-op menu (Image / Button / Text / InputField). -->
    <Reference Include="UnityEngine.UI">
      <HintPath>$(BepInExPath)\interop\UnityEngine.UI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UIModule">
      <HintPath>$(BepInExPath)\interop\UnityEngine.UIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- Community helper library (Venomaus). Loaded by Gale, do not copy. -->
    <Reference Include="SOD.Common">
      <HintPath>$(BepInExPath)\plugins\Venomaus-SODCommon\SOD.Common.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!--
      Steamworks.NET — the game's Assembly-CSharp uses `using Steamworks;` so
      Il2CppInterop emits an interop shim alongside Assembly-CSharp.dll. We
      reference the shim and call SteamMatchmaking / SteamNetworkingSockets /
      SteamFriends from our managed plugin. Private=false because the game
      already loaded the underlying steam_api64.dll into the process.
    -->
    <Reference Include="Steamworks.NET">
      <HintPath>$(BepInExPath)\interop\Steamworks.NET.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- Build output -->
  <PropertyGroup>
    <OutputPath>bin\$(Configuration)\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <!-- Post-build: Copy to BepInEx plugins folder -->
  <Target Name="CopyToPlugins" AfterTargets="Build" Condition="Exists('$(BepInExPath)\plugins')">
    <MakeDir Directories="$(BepInExPath)\plugins\SoDCoop" />
    <Copy SourceFiles="$(OutputPath)$(AssemblyName).dll" DestinationFolder="$(BepInExPath)\plugins\SoDCoop" />
    <Copy SourceFiles="$(OutputPath)LiteNetLib.dll" DestinationFolder="$(BepInExPath)\plugins\SoDCoop" />
    <Copy SourceFiles="$(OutputPath)ZstdSharp.dll" DestinationFolder="$(BepInExPath)\plugins\SoDCoop" Condition="Exists('$(OutputPath)ZstdSharp.dll')" />
    <Message Text="Copied SoDCoop to $(BepInExPath)\plugins\SoDCoop" Importance="high" />
  </Target>
</Project>
